# Test double for SCP. It copies the configured fixture to the destination.
set -eu
: "${SRM_DHCP_TEST_FIXTURE:?SRM_DHCP_TEST_FIXTURE is required}"
destination="${!#}"
cp "$SRM_DHCP_TEST_FIXTURE" "$destination"
