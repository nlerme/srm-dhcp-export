# OpenSSH test double for connection, export, transfer, and cleanup paths.

set -eu

: "${SRM_DHCP_TEST_MODE:=success}"
arguments="$*"

if [[ -n "${SRM_DHCP_TEST_LOG:-}" ]]; then
    printf '%s\n' "$arguments" >> "$SRM_DHCP_TEST_LOG"
fi

if [[ "$arguments" == *"SSH connection established"* ]]; then
    [[ "$SRM_DHCP_TEST_MODE" == "connection-failure" ]] && exit 255
    printf 'SSH connection established.\n'
    exit 0
fi

if [[ "$arguments" == *"grep '^[[:space:]]*dhcp-host='"* ]]; then
    [[ "$SRM_DHCP_TEST_MODE" == "export-failure" ]] && exit 41
    exit 0
fi

if [[ "$arguments" == *"Remote reservation list is not readable"* ]]; then
    case "$SRM_DHCP_TEST_MODE" in
        download-failure) exit 43 ;;
        empty-download) exit 0 ;;
    esac

    : "${SRM_DHCP_TEST_FIXTURE:?SRM_DHCP_TEST_FIXTURE is required}"
    cat "$SRM_DHCP_TEST_FIXTURE"
    exit 0
fi

# Remote cleanup and ControlMaster shutdown both succeed in the test double.
exit 0
